# Response headers for the pages and files in public/ (Workers static assets). The Worker's own
# responses (the API) set theirs in src/http.ts. Security plan step 4 (docs/security-plan.md §3).
#
# The Content-Security-Policy is enforced (it was report-only first, until a run through every page,
# Plaid Link included, showed no violations; 2026-10-16). Violations show in the browser console;
# reports can't be collected (Access guards every endpoint). Anything new loaded from another origin
# needs its host here.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# The connect page also runs Plaid Link: its script, its frame, and Plaid's API hosts. No
# 'unsafe-inline': the report-only run showed Link doesn't need it. (Link's own frame has Plaid's
# policy, which blocks one of Plaid's inline scripts in Firefox; that's Plaid's, and harmless.)
/connect
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.plaid.com/link/v2/stable/link-initialize.js; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://production.plaid.com https://sandbox.plaid.com; manifest-src 'self'; worker-src 'self'; frame-src https://cdn.plaid.com/; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'

# SUB's screenshot reader (docs/sub.md §2a): Tesseract.js runs as WebAssembly, so only this page and
# its vendored files get 'wasm-unsafe-eval' (the worker's own policy comes from its file's headers).
# Everything else is the pages' policy; the dashboard's is unchanged.
/sub-scan
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'
/vendor/tesseract/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'

# JET (docs/trips.md §13): its map draws OpenFreeMap's tiles, style, sprites and fonts, so the /jet/
# pages and the vendored map library (whose worker fetches the tiles under its own file's policy) may
# reach tiles.openfreemap.org, and nothing else beyond 'self'. Every other page is unchanged.
/jet/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; connect-src 'self' https://tiles.openfreemap.org https://script.google.com https://script.googleusercontent.com; manifest-src 'self'; worker-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'
/vendor/maplibre/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; connect-src 'self' https://tiles.openfreemap.org; manifest-src 'self'; worker-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'
