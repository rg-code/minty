// Minty on Cloudflare Workers — one deployment per household (docs/serverless-plan.md).
// Secrets (Plaid keys, TOKEN_ENC_KEY) are NOT here: set them with `wrangler secret put`
// (deployed) or in .dev.vars (local, gitignored). See .dev.vars.example.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minty",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",

  // The existing dashboard pages, served as-is. API paths run the Worker first; everything
  // else is a static file. Cloudflare Access protects both at the edge.
  "assets": {
    "directory": "./app/static",
    "binding": "ASSETS",
    "run_worker_first": [
      "/healthz",
      "/users",
      "/items",
      "/accounts",
      "/capacity",
      "/transactions",
      "/transactions/*",
      "/tags",
      "/link/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minty",
      "database_id": "00000000-0000-0000-0000-000000000000", // placeholder; real id set up in P3
      "migrations_dir": "d1/migrations"
    }
  ],

  "vars": {
    // People, in display order: "key:Label,...". Each gets <key>_primary / <key>_backup
    // Plaid credential sets from secrets PLAID_CLIENT_ID_<KEY>_<SLOT> / PLAID_SECRET_<KEY>_<SLOT>.
    "MINTY_USERS": "me:Me,spouse:Spouse",
    "PLAID_ENV": "sandbox",
    // Only needed for OAuth banks in mobile webviews; web Link works without it. Must be HTTPS.
    "PLAID_REDIRECT_URI": "",
    "TRIAL_ITEM_CAP": "10",
    // Plaid pages synced per cron run (1 Plaid call + 1 D1 batch each; 250 transactions/page).
    // 10 stays well inside the free plan's per-invocation limits. Raise on Workers Paid.
    "SYNC_MAX_PAGES_PER_RUN": "10",
    // Cloudflare Access. Both must be set or every API call is refused (fail closed).
    // ACCESS_TEAM_DOMAIN: "<team>.cloudflareaccess.com"; ACCESS_AUD: the app's AUD tag.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Optional extra allow-list of Access emails (comma-separated). Empty = any Access user.
    "ALLOWED_LOGINS": ""
  },

  // Hourly sync (UTC), off the top of the hour. The only way sync runs: no HTTP endpoint.
  "triggers": { "crons": ["17 * * * *"] },

  "observability": { "enabled": true }
}
