# ── People: comma-separated key:Label, in display order (sets each person's colour) ──
# Keys are lowercase letters/digits. Defaults to me:Me,spouse:Spouse if unset.
# The dashboard's "+ Add user" page generates the lines for a new person.
MINTY_USERS=me:Me,spouse:Spouse

# ── Plaid Trial accounts: a PRIMARY + a BACKUP per person (PLAID_*_<KEY>_<SLOT>) ──
# New links land on <person>_primary until it hits the item cap, then overflow
# automatically to <person>_backup. Each is a separate Plaid Trial team.
PLAID_CLIENT_ID_ME_PRIMARY=
PLAID_SECRET_ME_PRIMARY=
PLAID_CLIENT_ID_ME_BACKUP=
PLAID_SECRET_ME_BACKUP=
PLAID_CLIENT_ID_SPOUSE_PRIMARY=
PLAID_SECRET_SPOUSE_PRIMARY=
PLAID_CLIENT_ID_SPOUSE_BACKUP=
PLAID_SECRET_SPOUSE_BACKUP=

PLAID_ENV=production            # Trial plan runs against 'production'; 'sandbox' to develop
PLAID_REDIRECT_URI=             # e.g. https://<host>.<tailnet>.ts.net/connect  (register in EVERY trial)
TRIAL_ITEM_CAP=10               # Plaid Trial per-account item limit; overflow triggers at this number

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated Tailscale logins allowed to reach the app (as shown by
# `tailscale status` / the Tailscale-User-Login header). Leave EMPTY to disable
# the gate (open to your whole tailnet). Set it to lock Minty to you two.
ALLOWED_LOGINS=you@example.com,spouse@example.com

# How often the in-process scheduler pulls new transactions (seconds). 21600 = 6h.
SYNC_INTERVAL_SECONDS=21600

# DB password is referenced by both the db container and DATABASE_URL below — keep them identical.
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://aggregator:CHANGE_ME@db:5432/aggregator

# Generate once:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=
