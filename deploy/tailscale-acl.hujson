// ─────────────────────────────────────────────────────────────────────────────
// EXAMPLE Tailscale ACL fragment — OPTIONAL, network-level hardening (layer 3).
//
// This is defense-in-depth ON TOP OF the app's identity gate (ALLOWED_LOGINS).
// The app gate alone already blocks unknown tailnet identities; this ACL also
// prevents other devices from even reaching port 443 on the Minty host.
//
// ⚠️  Your tailnet policy is GLOBAL. Do NOT paste this wholesale — it would
//     replace your existing rules and could cut off access to Immich and other
//     services. MERGE these pieces into your current policy at
//     https://login.tailscale.com/admin/acls, then test before saving.
//
// Assumes you reach Minty over Tailscale Serve on 443 and that the Immich
// host is reachable by its MagicDNS name. Replace the emails/host to match yours.
// ─────────────────────────────────────────────────────────────────────────────
{
  // Give the Minty host a friendly alias so grants can target it by name.
  "hosts": {
    "minty-host": "100.x.y.z"          // the Immich/Minty machine's Tailscale IP
  },

  "grants": [
    // Only these two people may reach the Minty host on 443 (the Serve port).
    {
      "src": ["you@example.com", "spouse@example.com"],
      "dst": ["minty-host"],
      "ip":  ["tcp:443"]
    }

    // Keep your other existing grants here (Immich, SSH, etc.) — do not delete them.
    // If your tailnet currently uses a broad "allow all" grant, narrow it carefully
    // rather than relying on it, or the rule above won't actually restrict anything.
  ]
}
